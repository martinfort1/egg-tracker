// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())

  buyers           Buyer[]
  sales            Sale[]
  employees        Employee[]
  employeePayments EmployeePayment[]
  feedBags         FeedBag[]
  cartons          Carton[]
  vaccines         Vaccine[]
  vaccineApplications VaccineApplication[]
  expenseCategories ExpenseCategory[]
  expenses         Expense[]
  eggLayings       EggLaying[]
  chickens         Chicken[]
  chickenDeaths    ChickenDeath[]
}

model Buyer {
  id      String  @id @default(uuid())
  name    String
  phone   String?
  address String?
  notes   String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  sales Sale[]
}

model Sale {
  id   String   @id @default(uuid())
  date DateTime @default(now())

  Extra Float
  N1    Float
  N2    Float
  N3    Float
  N4    Float

  ExtraPrice Float
  N1Price    Float
  N2Price    Float
  N3Price    Float
  N4Price    Float

  totalAmount Float
  amountPaid  Float @default(0)
  remainingAmount Float

  status SaleStatus @default(UNPAID)

  buyerId String
  buyer   Buyer  @relation(fields: [buyerId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Employee {
  id            String   @id @default(uuid())
  name          String
  phone         String
  salary        Int

  lastPaidDate  DateTime? 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  payments EmployeePayment[]
  salaryPeriods SalaryPeriod[]
}

model FeedBag {
  id             String     @id @default(uuid())
  date           DateTime   @default(now())
  amount         Float      // Amount in kg or bags
  price          Float      // Price per unit
  totalAmount    Float
  amountPaid     Float      @default(0)
  remainingAmount Float
  phase          Int        // 1 or 2 (feed phase)
  status         SaleStatus @default(UNPAID)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model Carton {
  id             String     @id @default(uuid())
  date           DateTime   @default(now())
  quantity       Int        // Number of cartons
  price          Float      // Price per carton
  totalAmount    Float
  amountPaid     Float      @default(0)
  remainingAmount Float
  status         SaleStatus @default(UNPAID)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model EmployeePayment {
  id              String   @id @default(uuid())
  amount          Float
  date            DateTime @default(now())
  description     String   @default("Salary") // Salary or Advance
  createdAt       DateTime @default(now())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  salaryPeriodId String?
  salaryPeriod   SalaryPeriod? @relation(fields: [salaryPeriodId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model SalaryPeriod {
  id         String   @id @default(uuid())
  month      Int
  year       Int
  salary     Int
  balance    Float    @default(0) // Carries over balance from previous month (overpayment or underpayment)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  EmployeePayment EmployeePayment[]

  createdAt  DateTime @default(now())

  @@unique([employeeId, month, year]) 
}

model Vaccine {
  id                    String   @id @default(uuid())
  name                  String
  durationDays          Int      @default(30) // Days between applications
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  applications VaccineApplication[]
}

model VaccineApplication {
  id                    String   @id @default(uuid())
  dateApplied           DateTime
  vaccineCost           Float   // Cost of vaccine for this application
  labourCost            Float   // Labour cost for this application
  totalCost             Float   // vaccineCost + labourCost
  notes                 String?
  createdAt             DateTime @default(now())

  vaccineId String
  vaccine   Vaccine @relation(fields: [vaccineId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

enum SaleStatus {
  PAID
  PARTIAL
  UNPAID
}

model ExpenseCategory {
  id        String   @id @default(uuid())
  name      String   
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  expenses Expense[]
}

model Expense {
  id          String   @id @default(uuid())
  date        DateTime @default(now())
  name        String  
  quantity    Float
  price       Float    
  totalAmount Float    
  description String? 
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId String
  category   ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])
}

model EggLaying {
  id        String   @id @default(uuid())
  date      String
  boxes     Int      
  cartons   Int     
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId, date])
}

model Chicken {
  id                String   @id @default(uuid())
  date              DateTime @default(now())
  amount            Int      // Number of chickens bought
  pricePerChicken   Float    // Price per chicken
  shippingCost      Float    // Shipping cost
  totalCost         Float    // Total cost
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id])

  deaths ChickenDeath[]
}

model ChickenDeath {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  amount    Int      // Number of chickens died
  notes     String?  // Reason or notes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chickenId String
  chicken   Chicken @relation(fields: [chickenId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])
}
